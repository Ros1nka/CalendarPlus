<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Стили для кнопки-ячейки -->
    <Style Selector="Button.day-cell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>
    </Style>

    <!-- Наведение на кнопку -->
    <Style Selector="Button.day-cell:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2Opacity20}"/>
    </Style>

    <!-- Выбранная кнопка -->
    <Style Selector="Button.day-cell:selected">
        <!-- <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight3Opacity20}"/> -->
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
    </Style>
    
    
    <!-- Day Cell Border Style -->
    <Style Selector="Border.day-cell">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.day-cell:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2Opacity20}"/>
    </Style>

    <Style Selector="Border.day-cell.selected">
        <Setter Property="Background" Value="SteelBlue"/>
        <Setter Property="TextBlock.Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.day-cell.selected:pointerover">
        <Setter Property="Background" Value="RoyalBlue"/>
    </Style>

    <!-- Day Cell Text Style -->
    <Style Selector="TextBlock.day-cell-text">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style Selector="TextBlock.day-cell-text.other-month">
        <Setter Property="Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"/>
    </Style>

    <Style Selector="TextBlock.day-cell-text.today">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
    </Style>
    
    <Style Selector="TextBlock.day-cell-text.weekend">
        <Setter Property="Foreground" Value="DarkRed"/>
    </Style>

    <!-- Weekday Header Style -->
    <Style Selector="TextBlock.weekday-header">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlDisabledBaseMediumLowBrush}"/>
        <Setter Property="Padding" Value="0,8"/>
    </Style>

    <!-- Month Navigation Button Style -->
    <Style Selector="Button.nav-button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
    </Style>

    <Style Selector="Button.nav-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SystemAccentColorLight2Opacity20}"/>
    </Style>

</Styles>
