<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CalendarPlus.ViewModels"
        xmlns:models="using:CalendarPlus.Models"
        x:Name="RootWindow"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CalendarPlus.Converters"
        mc:Ignorable="d" d:DesignWidth="450" d:DesignHeight="650"
        x:Class="CalendarPlus.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CalendarPlus"
        Width="450"
        Height="650"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:StringToCharsConverter x:Key="StringToChars" />
    </Window.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Month/Year Header with Navigation -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="16,12">
            <Button Content="&#xE76B;" Classes="nav-button" Command="{Binding PreviousMonthCommand}"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    HorizontalAlignment="Left" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Months.Count}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold" Margin="12,0" />
            <TextBlock Text="{Binding Months[1].MonthName}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="18" FontWeight="SemiBold" Margin="12,0" />
            <Button Content="&#xE76C;" Classes="nav-button" Command="{Binding NextMonthCommand}"
                    FontFamily="{DynamicResource SymbolThemeFontFamily}"
                    HorizontalAlignment="Right" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Weekday Headers -->
        <UniformGrid Grid.Row="1" Columns="7" Margin="58,4, 8, 4">
            <TextBlock Text="Пн" Classes="weekday-header" />
            <TextBlock Text="Вт" Classes="weekday-header" />
            <TextBlock Text="Ср" Classes="weekday-header" />
            <TextBlock Text="Чт" Classes="weekday-header" />
            <TextBlock Text="Пт" Classes="weekday-header" />
            <TextBlock Text="Сб" Classes="weekday-header" />
            <TextBlock Text="Вс" Classes="weekday-header" />
        </UniformGrid>

        <!-- Divider -->
        <Border Grid.Row="2" Height="1" Margin="8,0" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" />

        <!-- Calendar Grid -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Hidden">
            <!-- Внешний ItemsControl перебирает коллекцию Months -->
            <ItemsControl ItemsSource="{Binding Months}">

                <!-- 1. ЗАДАЕМ ШАБЛОН ДЛЯ ОДНОГО МЕСЯЦА (MonthData) -->
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:MonthData">

                        <!-- DataContext = текущий объект MonthData -->
                        <Grid ColumnDefinitions="50, *" Margin="0,8">

                            <!-- Заголовок месяца -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center"
                                        Spacing="18">
                                <ItemsControl
                                    ItemsSource="{Binding MonthName, Converter={StaticResource StringToChars}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="0" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       HorizontalAlignment="Center"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource PTMono}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl
                                    ItemsSource="{Binding Year, Converter={StaticResource StringToChars}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical" Spacing="2" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Bottom"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       FontFamily="{StaticResource PTMono}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <!-- Дни месяца с FirstColumn -->
                                <ItemsControl ItemsSource="{Binding Days}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="7"
                                                         FirstColumn="{Binding FirstColumn}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:DateCell">
                                            <Button Classes="day-cell"
                                                    Classes.selected="{Binding IsSelected}"
                                                    Command="{Binding #RootWindow.DataContext.SelectDayCommand,
                                                    RelativeSource={RelativeSource AncestorType=views:Clishe}}">

                                                <Grid ColumnDefinitions="Auto, *">
                                                    <Border Grid.Column="0"
                                                            Width="32" Height="32"
                                                            CornerRadius="16"
                                                            BorderBrush="Black"
                                                            BorderThickness="2,1,1,1"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center">
                                                    </Border>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Day}"
                                                               Classes="day-cell-text"
                                                               Classes.other-month="{Binding !IsCurrentMonth}"
                                                               Classes.today="{Binding IsToday}"
                                                               Classes.weekend="{Binding IsWeekend}" />
                                                    <Grid Grid.Column="1" RowDefinitions="6, 6, 6, 6, 6">
                                                        <Grid Grid.Row="0" ColumnDefinitions="4, 4, 4" Margin="0,1,6,1">
                                                            <Rectangle Grid.Column="0" Fill="Blue"></Rectangle>
                                                            <Rectangle Grid.Column="1" Fill="Yellow"></Rectangle>
                                                            <Rectangle Grid.Column="2" Fill="Red"></Rectangle>
                                                        </Grid>
                                                        <Grid Grid.Row="1" ColumnDefinitions="4, 4, 4" Margin="3,1,3,1">
                                                            <Rectangle Grid.Column="0" Fill="Blue"></Rectangle>
                                                            <Rectangle Grid.Column="1" Fill="Yellow"></Rectangle>
                                                            <Rectangle Grid.Column="2" Fill="Red"></Rectangle>
                                                        </Grid>
                                                        <Grid Grid.Row="2" ColumnDefinitions="4, 4, 4" Margin="6,1,0,1">
                                                            <Rectangle Grid.Column="0" Fill="Blue"></Rectangle>
                                                            <Rectangle Grid.Column="1" Fill="Yellow"></Rectangle>
                                                            <Rectangle Grid.Column="2" Fill="Red"></Rectangle>
                                                        </Grid>
                                                        <Grid Grid.Row="3" ColumnDefinitions="4, 4, 4" Margin="3,1,3,1">
                                                            <Rectangle Grid.Column="0" Fill="Blue"></Rectangle>
                                                            <Rectangle Grid.Column="1" Fill="Yellow"></Rectangle>
                                                            <Rectangle Grid.Column="2" Fill="Red"></Rectangle>
                                                        </Grid>
                                                        <Grid Grid.Row="4" ColumnDefinitions="4, 4, 4" Margin="0,1,6,1">
                                                            <Rectangle Grid.Column="0" Fill="Blue"></Rectangle>
                                                            <Rectangle Grid.Column="1" Fill="Yellow"></Rectangle>
                                                            <Rectangle Grid.Column="2" Fill="Red"></Rectangle>
                                                        </Grid>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Разделитель между месяцами -->
                                <Border Height="1"
                                        Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                        Margin="8,8,8,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>

</Window>